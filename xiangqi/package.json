{
  "name": "xiangqi-frontend",
  "version": "1.0.0",
  "description": "Xiangqi online - Modern Chinese chess with AI, ELO, and real-time multiplayer",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint:js": "eslint src/ --ext .js",
    "format": "prettier --write 'src/**/*.js' 'src/**/*.css'",
    "audit:a11y": "pa11y-ci --config .pa11yci.json",
    "audit:lighthouse": "lighthouse https://localhost:5173 --chrome-flags='--headless' --output=json --output-path=./lighthouse-report.json || true"
  },
  "devDependencies": {
    "vite": "^5.0.0",
    "@vitejs/plugin-basic-ssl": "^1.0.0",
    "vite-plugin-compression": "^0.5.1",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "axe-core": "^4.7.0",
    "pa11y-ci": "^2.4.2",
    "lighthouse": "^11.0.0",
    "sharp": "^0.33.0",
    "imagemin": "^8.0.0",
    "imagemin-webp": "^7.0.0",
    "imagemin-avif": "^0.0.1"
  },
  "dependencies": {
    "@sentry/browser": "^7.80.0",
    "web-vitals": "^3.3.0"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead"
  ]
}
