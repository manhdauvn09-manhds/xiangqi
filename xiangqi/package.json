{
  "name": "xiangqi-frontend",
  "version": "1.0.0",
  "description": "Xiangqi online - Modern Chinese chess with AI, ELO, and real-time multiplayer",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint:js": "eslint src/ --ext .js",
    "format": "prettier --write 'src/**/*.js' 'src/**/*.css'",
    "audit:a11y": "pa11y-ci --config .pa11yci.json",
    "audit:lighthouse": "lighthouse https://localhost:5173 --chrome-flags='--headless' --output=json --output-path=./lighthouse-report.json || true"
  },
  "devDependencies": {
    "vite": "^5.0.0",
    "eslint": "^8.0.0"
  },
  "dependencies": {
    "@sentry/browser": "^7.80.0",
    "web-vitals": "^3.3.0"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead"
  ]
}
